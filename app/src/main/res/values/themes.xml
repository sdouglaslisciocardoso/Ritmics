<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ritmics" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted_ink</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Text.Ritmics.Label" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Ritmics.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
