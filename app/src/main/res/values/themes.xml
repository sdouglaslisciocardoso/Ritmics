<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The training screen is designed dark-only. -->
    <style name="Theme.Ritmics" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/muted_ink</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted_ink</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Text.Ritmics.Brand" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Ritmics.Tagline" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted_ink</item>
    </style>
    <style name="Text.Ritmics.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Ritmics.CardTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Ritmics.Label" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Ritmics.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Text.Ritmics.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Ritmics.StepButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_round_button</item>
        <item name="android:textColor">@color/control_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Ritmics.PrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Ritmics.SecondaryButton" parent="Widget.Ritmics.PrimaryButton">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/control_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Ritmics.Chip" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/choice_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Widget.Ritmics.SubdivisionTile" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_subdivision</item>
        <item name="android:foregroundGravity">center</item>
        <item name="android:foregroundTint">@color/on_choice_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Widget.Ritmics.Beat" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_beat</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_choice_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.Ritmics.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seek_track_filled</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
    </style>
    <!-- The tempo slider keeps the design's neutral track; only the thumb carries the accent. -->
    <style name="Widget.Ritmics.SeekBar.Plain">
        <item name="android:progressDrawable">@drawable/seek_track</item>
    </style>
    <style name="Widget.Ritmics.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
</resources>
