<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_heading" android:textColor="@color/accent"
            android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.2" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/heading"
            android:textSize="32sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/intro" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical" android:padding="20dp"
            android:background="@drawable/panel_background">
            <TextView style="@style/Text.Ritmics.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/tempo_label" android:labelFor="@id/bpm_input" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <Button android:id="@+id/decrease" android:layout_width="56dp" android:layout_height="64dp"
                    android:text="@string/minus" android:contentDescription="@string/decrease_bpm" android:textSize="24sp" />
                <EditText android:id="@+id/bpm_input" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:minHeight="80dp" android:gravity="center"
                    android:inputType="number" android:maxLength="3" android:selectAllOnFocus="true"
                    android:singleLine="true" android:imeOptions="actionDone" android:textSize="48sp"
                    android:importantForAutofill="no" android:contentDescription="@string/bpm_description" />
                <Button android:id="@+id/increase" android:layout_width="56dp" android:layout_height="64dp"
                    android:text="@string/plus" android:contentDescription="@string/increase_bpm" android:textSize="24sp" />
            </LinearLayout>
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:text="@string/bpm_unit" />
            <SeekBar android:id="@+id/bpm_slider" android:layout_width="match_parent" android:layout_height="48dp"
                android:max="210" android:contentDescription="@string/bpm_description" />
            <Button android:id="@+id/apply_bpm" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/apply_bpm" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/tempo_hint" />
            <TextView android:id="@+id/pending_tempo" style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/tempo_live_hint" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp"
            android:background="@drawable/panel_background">
            <TextView style="@style/Text.Ritmics.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/meter_label" android:labelFor="@id/meter" />
            <Spinner android:id="@+id/meter" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:entries="@array/meters" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/accent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/accent_label" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/subdivision" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/subdivision_label" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/subdivision_hint" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/structure_hint" />
        </LinearLayout>

        <TextView android:id="@+id/volume_label" style="@style/Text.Ritmics.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:labelFor="@id/volume" />
        <SeekBar android:id="@+id/volume" android:layout_width="match_parent"
            android:layout_height="48dp" android:max="100" android:contentDescription="@string/volume_description" />
        <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/volume_hint" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/mute" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/mute_label" />
        <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/mute_hint" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp"
            android:background="@drawable/panel_background">
            <TextView style="@style/Text.Ritmics.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/microphone_title" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/use_microphone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/microphone_label" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/microphone_hint" />
            <TextView android:id="@+id/microphone_status" style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
                android:text="@string/microphone_ready" />
            <ProgressBar android:id="@+id/microphone_level" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="24dp" android:max="100"
                android:progress="0" android:contentDescription="@string/microphone_level_description" />
            <TextView android:id="@+id/sensitivity_label" style="@style/Text.Ritmics.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:labelFor="@id/sensitivity" android:text="@string/sensitivity_title" />
            <SeekBar android:id="@+id/sensitivity" android:layout_width="match_parent"
                android:layout_height="48dp" android:max="100" android:progress="50"
                android:contentDescription="@string/sensitivity_title" />
            <TextView android:id="@+id/detector_status" style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/detector_idle" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/detector_limit" />
            <Button android:id="@+id/probe_start" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/probe_start" />
            <TextView android:id="@+id/probe_status" style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" android:text="@string/probe_idle" />
            <Button android:id="@+id/microphone_settings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/open_microphone_settings" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/status" style="@style/Text.Ritmics.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/status_ready" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/start" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="56dp" android:text="@string/start"
                android:backgroundTint="@color/accent" android:textColor="@color/on_accent" />
            <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:minHeight="56dp" android:text="@string/stop" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical" android:padding="20dp"
            android:background="@drawable/panel_background">
            <TextView style="@style/Text.Ritmics.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/diagnostics_title" />
            <TextView android:id="@+id/diagnostics" style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/diagnostics_idle" android:textIsSelectable="true" />
            <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/diagnostics_limit" />
        </LinearLayout>
        <TextView style="@style/Text.Ritmics.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/stage_notice" />
    </LinearLayout>
</ScrollView>
