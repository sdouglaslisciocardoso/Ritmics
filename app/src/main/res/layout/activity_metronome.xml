<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Receives focus at launch and after BPM editing, so the tempo field shows no cursor. -->
        <View
            android:id="@+id/focus_sink"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_pulse" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Ritmics.Brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/Text.Ritmics.Tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/open_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/settings_open"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/mode_live"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_card"
                        android:focusable="true"
                        android:minHeight="148dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/mode_live_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tile"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:scaleType="center"
                            android:src="@drawable/ic_bolt" />

                        <TextView
                            style="@style/Text.Ritmics.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/mode_live_title" />

                        <TextView
                            style="@style/Text.Ritmics.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mode_live_description" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mode_recorded"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_card"
                        android:focusable="true"
                        android:minHeight="148dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_tile"
                                android:importantForAccessibility="no"
                                android:scaleType="center"
                                android:src="@drawable/ic_record" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                style="@style/Text.Ritmics.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="@string/mode_soon"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/Text.Ritmics.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/mode_recorded_title" />

                        <TextView
                            style="@style/Text.Ritmics.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mode_recorded_description" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/live_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/panel_background"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.Ritmics.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/live_title" />

                    <TextView
                        android:id="@+id/microphone_status"
                        style="@style/Text.Ritmics.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/microphone_ready"
                        android:textColor="@color/ink" />

                    <ProgressBar
                        android:id="@+id/microphone_level"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/microphone_level_description"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/seek_track_filled" />

                    <TextView
                        android:id="@+id/detector_status"
                        style="@style/Text.Ritmics.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/detector_idle" />

                    <Button
                        android:id="@+id/microphone_settings"
                        style="@style/Widget.Ritmics.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/open_microphone_settings"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/panel_background"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/Text.Ritmics.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:labelFor="@id/bpm_input"
                        android:text="@string/tempo_heading"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/decrease"
                            style="@style/Widget.Ritmics.StepButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/decrease_bpm"
                            android:text="@string/minus" />

                        <EditText
                            android:id="@+id/bpm_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:contentDescription="@string/bpm_description"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:maxLength="3"
                            android:minHeight="88dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="@color/ink"
                            android:textCursorDrawable="@null"
                            android:textSize="68sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/increase"
                            style="@style/Widget.Ritmics.StepButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/increase_bpm"
                            android:text="@string/plus" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/bpm_slider"
                        style="@style/Widget.Ritmics.SeekBar.Plain"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:contentDescription="@string/bpm_description"
                        android:max="210" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">

                        <TextView
                            style="@style/Text.Ritmics.Mono"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/bpm_min" />

                        <TextView
                            style="@style/Text.Ritmics.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/bpm_max" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pending_tempo"
                        style="@style/Text.Ritmics.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:textColor="@color/accent"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/meter_heading" />

                <RadioGroup
                    android:id="@+id/meter_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/meter_2_4"
                        style="@style/Widget.Ritmics.Chip"
                        android:layout_width="68dp"
                        android:layout_height="48dp"
                        android:text="@string/meter_2_4" />

                    <RadioButton
                        android:id="@+id/meter_3_4"
                        style="@style/Widget.Ritmics.Chip"
                        android:layout_width="68dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/meter_3_4" />

                    <RadioButton
                        android:id="@+id/meter_4_4"
                        style="@style/Widget.Ritmics.Chip"
                        android:layout_width="68dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/meter_4_4" />

                    <RadioButton
                        android:id="@+id/meter_6_8"
                        style="@style/Widget.Ritmics.Chip"
                        android:layout_width="68dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/meter_6_8" />
                </RadioGroup>

                <TextView
                    android:id="@+id/meter_caption"
                    style="@style/Text.Ritmics.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/subdivision_heading" />

                <RadioGroup
                    android:id="@+id/subdivision_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/subdivision_1"
                        style="@style/Widget.Ritmics.SubdivisionTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/subdivision_1_description"
                        android:foreground="@drawable/ic_note_quarter" />

                    <RadioButton
                        android:id="@+id/subdivision_2"
                        style="@style/Widget.Ritmics.SubdivisionTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/subdivision_2_description"
                        android:foreground="@drawable/ic_note_eighths" />

                    <RadioButton
                        android:id="@+id/subdivision_3"
                        style="@style/Widget.Ritmics.SubdivisionTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/subdivision_3_description"
                        android:foreground="@drawable/ic_note_triplets" />

                    <RadioButton
                        android:id="@+id/subdivision_4"
                        style="@style/Widget.Ritmics.SubdivisionTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/subdivision_4_description"
                        android:foreground="@drawable/ic_note_sixteenths" />
                </RadioGroup>

                <TextView
                    android:id="@+id/subdivision_caption"
                    style="@style/Text.Ritmics.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/accent_heading" />

                <TextView
                    android:id="@+id/accent_hint"
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/accent_hint" />

                <LinearLayout
                    android:id="@+id/accent_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/status"
                style="@style/Text.Ritmics.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/status_ready"
                android:visibility="gone" />

            <Button
                android:id="@+id/start"
                style="@style/Widget.Ritmics.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start" />

            <Button
                android:id="@+id/stop"
                style="@style/Widget.Ritmics.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="@string/stop"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/panel_settings" />
</FrameLayout>
