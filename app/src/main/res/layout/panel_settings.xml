<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Text.Ritmics.Brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title" />

        <ImageButton
            android:id="@+id/close_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/settings_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_title" />

                <TextView
                    android:id="@+id/volume_label"
                    style="@style/Text.Ritmics.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/volume" />

                <SeekBar
                    android:id="@+id/volume"
                    style="@style/Widget.Ritmics.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/volume_description"
                    android:max="100" />

                <TextView
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/mute"
                    style="@style/Widget.Ritmics.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mute_label" />

                <TextView
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mute_hint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/microphone_title" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/use_microphone"
                    style="@style/Widget.Ritmics.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/microphone_label" />

                <TextView
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/microphone_hint" />

                <TextView
                    android:id="@+id/sensitivity_label"
                    style="@style/Text.Ritmics.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@id/sensitivity"
                    android:text="@string/sensitivity_title" />

                <SeekBar
                    android:id="@+id/sensitivity"
                    style="@style/Widget.Ritmics.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/sensitivity_title"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detector_limit" />

                <Button
                    android:id="@+id/probe_start"
                    style="@style/Widget.Ritmics.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/probe_start" />

                <TextView
                    android:id="@+id/probe_status"
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/probe_idle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.Ritmics.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_title" />

                <TextView
                    android:id="@+id/diagnostics"
                    style="@style/Text.Ritmics.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/diagnostics_idle"
                    android:textIsSelectable="true" />

                <TextView
                    style="@style/Text.Ritmics.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diagnostics_limit" />
            </LinearLayout>

            <TextView
                style="@style/Text.Ritmics.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/stage_notice" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
